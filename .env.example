# Environment for the dockerized PAL V2 server (compose.yaml). Copy to .env, or run
# docker/init-env.sh to create .env with HOST_IP detected automatically.

# This machine's LAN IPv4 - the address the PS2 / PCSX2 dials. Everything below uses it.
HOST_IP=

# Unique per server: generate ONCE (openssl rand -hex 32) and keep it - it seals the stored
# account secrets, so losing or changing it loses every account.
PAL_V2_MASTER_KEY=

PAL_V2_DATA_DIR=/data
PAL_V2_SELF_HOST=${HOST_IP}
PAL_V2_SNAP_HOST=${HOST_IP}

PAL_V2_DIRECTORY_FILE=/config/directory.json

PAL_V2_LOBBY_NAME=Outbreak de Erizo
PAL_V2_WELCOME_MESSAGE=No me vas a creer bro, esto corre en una Raspberry Pi 400
PAL_V2_BIND_HOST=0.0.0.0
PAL_V2_LOG_LEVEL=debug

PAL_V2_ENABLE_DNS=true

PAL_V2_DNS_RECORDS=gate1.eu.dnas.playstation.org=${HOST_IP},stage6.sega.com=${HOST_IP},snap01.capcom.client.sf.yav4.com=${HOST_IP},app01.reo.capcom.sf.yav4.com=${HOST_IP}

PAL_V2_ENABLE_DNAS=true

# Baked into the image from DNASrep (etc/dnas and www/dnas/eu-gw/packets).
PAL_V2_DNAS_CERT=/dnas/certs/cert-eu.pem
PAL_V2_DNAS_CA_CERT=/dnas/certs/ca-cert.pem
PAL_V2_DNAS_KEY=/dnas/certs/cert-eu-key.pem
PAL_V2_DNAS_PACKET_DIR=/dnas/packets
PAL_V2_DNAS_PORT=443

PAL_V2_DYNAMIC_DNAS_TOKEN=true

PAL_V2_UDP_BIND_ADDRESS=${HOST_IP}
PAL_V2_UDP_ATTACHMENT_NONCE=true

# --- SN@P behavior flags (the rig-validated set, deploy/pal-server-v2.env.conf) ---
# NEVER set SNAP_GAME_BEACON_ECHO=1 (proven fatal).
SNAP_EXIT_CLOSE_MIRROR=1
SNAP_COMPLETION_SEQ_ECHO=1
SNAP_GAME_BEACON_ECHO=0
SNAP_COUNT_PUSH=0
SNAP_CHANNEL_BIT_ECHO=true
SNAP_GAME_RELAY=true
SNAP_ROOM_STAT=true
SNAP_ROSTER_TO_JOINER=true
SNAP_MEMBER_ID_TOKEN=true
SNAP_HOST_RESEAT=true
SNAP_OP10_DROP_SELF=true
SNAP_CHARSTATS_SEED=true
SNAP_GAME_BEACON_RELAY=true

# --- Under test (not yet console-validated) ---
# Re-send the room header ("N of 4") after each in-room member query. Remove to roll back.
SNAP_ROOM_LIMITS_ON_QUERY=true
